[DEFAULT]
# VPN clients and the host itself are never banned: they hold keys, and the tooling logs in often
ignoreip = 127.0.0.1/8 ::1 10.8.0.0/24
banaction = nftables-multiport
backend = systemd
bantime = 1h
findtime = 10m
maxretry = 3
[sshd]
enabled = true
mode = aggressive
# clients that keep tripping the WAF (Caddy logs every block) are banned at the firewall
[pocketcloud-waf]
enabled = true
filter = pocketcloud-waf
port = http,https
maxretry = 10
findtime = 10m
bantime = 1h
